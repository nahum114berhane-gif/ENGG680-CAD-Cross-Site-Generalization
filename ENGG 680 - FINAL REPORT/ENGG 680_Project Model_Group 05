{"cells":[{"cell_type":"markdown","metadata":{"id":"YNprrKkWUA3N"},"source":["# Cross-Site Generalization of Coronary Artery Disease (CAD) Models on the UCI Heart Disease Sites"]},{"cell_type":"code","execution_count":4,"metadata":{"executionInfo":{"elapsed":20,"status":"ok","timestamp":1795710322886,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"vgeog_A7Mu4E"},"outputs":[],"source":["# A1: Train on Cleveland           --> Test on Hungary, Switzerland, and Long Beach\n","# A2: Train on Cleveland + Hungary --> Test on Switzerland and Long Beach"]},{"cell_type":"code","execution_count":5,"metadata":{"executionInfo":{"elapsed":2736,"status":"ok","timestamp":1795710325642,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"hNzrte5KYsLv"},"outputs":[],"source":["# Load the libraries\n","\n","import warnings # Hides unimportant warnings so the output is easier to read.\n","\n","from pathlib import Path # Finds and works with files and folders.\n","import numpy as np       # Used to perform mathematical calculations.\n","import pandas as pd      # Organizes and works with data in tables.\n","\n","from sklearn.compose import ColumnTransformer # Treats different columns differently.\n","from sklearn.pipeline import Pipeline         # Connects different steps together.\n","\n","from sklearn.impute import SimpleImputer\n","  # Replaces missing values with the median and missing categories with the most\n","  # common answer.\n","\n","from sklearn.preprocessing import StandardScaler, OneHotEncoder\n","  # StandardScaler - Puts numbers on a similar scale so larger numbers do not\n","  #                   have more influence just because they are larger.\n","  # OneHotEncoder   - Changes categories into separate columns of 0s and 1s.\n","\n","from sklearn.linear_model import LogisticRegression\n","  # Model 1 (simple and easy to interpret)\n","from sklearn.ensemble import RandomForestClassifier\n","  # Model 2 (uses many decision trees to find patterns)\n","from sklearn.ensemble import GradientBoostingClassifier\n","  # Model 3 (boosted trees; improves predictions)\n","\n","from sklearn.metrics import roc_auc_score, brier_score_loss\n","  # roc_auc_score - Measures how well the model separates sick patients from\n","  #                 healthy patients. A score of 0.5 means random guessing,\n","  #                 while 1.0 means perfect separation.\n","  # brier_score_loss - Measures how close the model's predicted risks are to\n","  #                    the actual results. The lower the score, the better the prediction.\n","\n","from sklearn.model_selection import RepeatedStratifiedKFold, cross_val_score\n","  # RepeatedStratifiedKFold - Splits the training data into 5 groups and\n","  #                           repeats this 3 times. It keeps a similar proportion\n","  #                           of sick patients in each group.\n","  # cross_val_score - Tests how well the model performs by training the model\n","  #                   using 4 groups and testing it on the remaining group. It\n","  #                   repeats the process to calculate the internal AUC score.\n","\n","from sklearn.inspection import permutation_importance\n","  # Shuffles one feature at a time to check how much the model's AUC score\n","  # drops. A bigger drop means that feature is more important to the model.\n","\n","\n","warnings.filterwarnings(\"ignore\") # Hides warning messages."]},{"cell_type":"code","execution_count":6,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":27173,"status":"ok","timestamp":1795710352817,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"AIXvcFG1mhOX","outputId":"840b30fb-a967-4cae-ec8a-5fc976e51f84"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive/\n"]}],"source":["# Connect Colab to Google Drive\n","from google.colab import drive\n","drive.mount(\"/content/drive/\")\n","work_folder = Path(\"/content/drive/MyDrive/ENGG 680 - FINAL REPORT/\")\n","\n","data_folder = work_folder             # The 4 UCI files are in this folder\n","out_folder = work_folder / \"results\"  # The results will be saved in a new \"results\" folder\n","out_folder.mkdir(exist_ok = True)     # Creates the \"results\" folder if it does not exist yet"]},{"cell_type":"code","execution_count":7,"metadata":{"executionInfo":{"elapsed":2,"status":"ok","timestamp":1795710352829,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"WDv3-Pp61fcU"},"outputs":[],"source":["# Important Numbers\n","SEED = 42     # Makes random steps repeat the same way every run.\n","N_BOOT = 1000 # Python repeats the testing 1,000 times to determine how reliable\n","              # the results are (confidence interval).\n","\n","N_PERM = 10   # Python shuffles each feature 10 times to determine its importance\n","              # for the model.\n","CUTOFF = 0.5  # If >= 0.5, the model predicts the patient has the disease."]},{"cell_type":"code","execution_count":8,"metadata":{"executionInfo":{"elapsed":47,"status":"ok","timestamp":1795710352878,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"027Tijkt1lub"},"outputs":[],"source":["# The 4 hospitals and their file names:\n","Files = {\n","    \"Cleveland\":   \"processed.cleveland.csv\",\n","    \"Hungary\":     \"processed.hungarian.csv\",\n","    \"Switzerland\": \"processed.switzerland.csv\",\n","    \"LongBeach\":   \"processed.va.csv\",\n","}"]},{"cell_type":"code","execution_count":9,"metadata":{"executionInfo":{"elapsed":5,"status":"ok","timestamp":1795710352879,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"gKFTUbuh1pqW"},"outputs":[],"source":["# The files have no header row, so we give each column a name based on the information\n","# provided on the dataset site.\n","# There are 13 measurements (\"features\") and 1 answer column called \"num\".\n","column_names = [\"age\", \"sex\", \"cp\", \"trestbps\", \"chol\", \"fbs\", \"restecg\", \"thalach\",\n","                \"exang\", \"oldpeak\", \"slope\", \"ca\", \"thal\", \"num\"]\n","                # age in years\n","                # sex: 1 = male, 0 = female\n","                # cp = chest pain, 4 types:\n","                     # 1 = typical angina,\n","                     # 2 = atypical angina,\n","                     # 3 = non-anginal pain,\n","                     # 4 = asymptomatic\n","                # trestbps = resting blood pressure (mmHg)\n","                # chol = serum cholesterol\n","                # fbs = fasting blood sugar >120 mg/dl (diabetes related risk marker)\n","                     # 1 = true, 0 = false\n","                # restecg = resting ECG result\n","                     # 0 = normal\n","                     # 1 = ST-T wave abnormality (T-wave inversions and/or ST elevation or depression of > 0.05 mV)\n","                     # 2 = probable or definite left ventricular hypertrophy by Estes' criteria\n","                # The following four are recorded during an exercise test:\n","                # thalach = maximum heart rate achieved\n","                # exang   = exercise-induced angina - 1 = yes, 0 = no\n","                # oldpeak = ST depression during exercise\n","                # slope   = slope of the ST segment at peak exercise\n","                     # 1 = upsloping\n","                     # 2 = flat\n","                     # 3 = downsloping\n","\n","                # ca = number of major vessels (0-3) showing calcium or blockage on fluoroscopy\n","                # thal = thallium stress test result - nuclear stress imaging\n","                     # 3 = normal\n","                     # 6 = fixed defect\n","                     # 7 = reversible defect\n","\n","                # num = the angiographic disease status:\n","                     # 0 = no major vessel has more than 50% narrowing\n","                     # 1-4 = at least one major vessel has more than 50% narrowing\n","\n","all_13_features = column_names[:-1] # every column except the last (num)"]},{"cell_type":"code","execution_count":10,"metadata":{"executionInfo":{"elapsed":2,"status":"ok","timestamp":1795710352881,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"7a0mJObHzYna"},"outputs":[],"source":["# Group features by TYPE, because each type needs different handling:\n","number_features = [\"age\", \"trestbps\", \"chol\", \"thalach\", \"oldpeak\"] # real numbers\n","yes_no_features = [\"sex\", \"fbs\", \"exang\"]                           # 0 or 1\n","category_features = [\"cp\", \"restecg\"]                               # labels, i.e. chest pain type\n","\n","# TIERS = four different lists of features the model may use:\n","  # accessible : cheap, simple measurements (main analysis)\n","  # accessible_no_chol: same as accessible but without cholesterol as Switzerland\n","  #                     almost no cholesterol data; this allows for a fairer comparison\n","  # +ecg:        accessible + the resting ECG\n","  # full:        accessible, ECG, and the exercise-test measurements\n","  #              (thalach, exang, oldpeak)\n","# Leaving out slope, ca, and thal as they are largely missing at Hungary\n","# and Long Beach; ca is also 96% missing at Switzerland. See the missingness\n","# table.\n","\n","TIERS = {\n","    \"accessible\": [\"age\", \"sex\", \"cp\", \"trestbps\", \"chol\", \"fbs\"],\n","    \"accessible_no_chol\": [\"age\", \"sex\", \"cp\", \"trestbps\", \"fbs\"],\n","    \"+ecg\":       [\"age\", \"sex\", \"cp\", \"trestbps\", \"chol\", \"fbs\", \"restecg\"],\n","    \"full\":       [\"age\", \"sex\", \"cp\", \"trestbps\", \"chol\", \"fbs\", \"restecg\",\n","                     \"thalach\", \"exang\", \"oldpeak\"],\n","}"]},{"cell_type":"code","execution_count":11,"metadata":{"executionInfo":{"elapsed":1,"status":"ok","timestamp":1795710352891,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"7TNY9VkZ1xme"},"outputs":[],"source":["# THE TWO SETUPS (hospitals to train on, hospitals to test on):\n","setups = {\n","    \"A1: Cleveland\": ([\"Cleveland\"], [\"Hungary\", \"Switzerland\", \"LongBeach\"]),\n","    \"A2: Cleveland+Hungary\": ([\"Cleveland\", \"Hungary\"], [\"Switzerland\", \"LongBeach\"]),\n","}"]},{"cell_type":"code","execution_count":12,"metadata":{"executionInfo":{"elapsed":1662,"status":"ok","timestamp":1795710354554,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"-J-5Z25K2x0X"},"outputs":[],"source":["# Read each hospital's file and clean it\n","\n","def load_hospital(name):\n","  path = data_folder / Files[name]\n","  if not path.exists():                    # Friendly error if file is missing.\n","    raise SystemExit(f\"Cannot find {path}. Did you put the 4 files in the right folder?\")\n","\n","  # In the files, a \"?\" means \"not recorded\", so we tell pandas to treat \"?\" as an\n","  # empty (missing) value.\n","  table = pd.read_csv(path, header = None, names = column_names, na_values = \"?\")\n","\n","  # Cholesterol or blood pressure of 0 is impossible for a living person, so we treat\n","  # those as \"not measured\" and turn them into missing values.\n","  for column in [\"chol\", \"trestbps\"]:\n","    table.loc[table[column] == 0, column] = np.nan\n","\n","  # The answer column \"num\" is 0 = no disease or 1-4 = disease of different severities.\n","  # We only care about yes/no, so 0 stays 0 (no disease), and anything above 0 becomes 1 (disease).\n","  table[\"target\"] = (table[\"num\"] > 0).astype(int)\n","  return table\n","\n","# Load all four hospitals into a dictionary\n","hospitals = {name: load_hospital(name) for name in Files}"]},{"cell_type":"code","execution_count":13,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":806,"status":"ok","timestamp":1795710355345,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"MVigNhYd6VkK","outputId":"2ea97dc5-5e03-4cd0-cfa2-748354984b4b"},"outputs":[{"output_type":"stream","name":"stdout","text":["\n","% of values missing, per feature and hospital:\n","          Cleveland  Hungary  Switzerland  LongBeach\n","age             0.0      0.0          0.0        0.0\n","sex             0.0      0.0          0.0        0.0\n","cp              0.0      0.0          0.0        0.0\n","trestbps        0.0      0.0          2.0       28.0\n","chol            0.0      8.0        100.0       28.0\n","fbs             0.0      3.0         61.0        4.0\n","restecg         0.0      0.0          1.0        0.0\n","thalach         0.0      0.0          1.0       26.0\n","exang           0.0      0.0          1.0       26.0\n","oldpeak         0.0      0.0          5.0       28.0\n","slope           0.0     65.0         14.0       51.0\n","ca              1.0     99.0         96.0       99.0\n","thal            1.0     90.0         42.0       83.0\n","\n","Hospital Summary:\n","   hospital  patients  with_disease  without_disease  disease_%  median_age  male_%\n","  Cleveland       303           139              164       45.9        56.0    68.0\n","    Hungary       294           106              188       36.1        49.0    72.4\n","Switzerland       123           115                8       93.5        56.0    91.9\n","  LongBeach       200           149               51       74.5        60.0    97.0\n"]}],"source":["# Describe the data, so we know what we are working with\n","\n","# How much of all 13 features is missing at each hospital?\n","missing_table = pd.DataFrame({\n","    name: (table[all_13_features].isna().mean() * 100).round(0) # % missing\n","    for name, table in hospitals.items()\n","})\n","\n","missing_table.to_csv(out_folder / \"missingness_all_features.csv\")\n","print(\"\\n% of values missing, per feature and hospital:\")\n","print(missing_table.to_string())\n","\n","# A summary of each hospital: size, how many sick, age, % male.\n","summary_rows = []\n","for name, table in hospitals.items():\n","  summary_rows.append({\n","      \"hospital\": name,\n","      \"patients\": len(table),\n","      \"with_disease\": int(table[\"target\"].sum()),\n","      \"without_disease\": int((table[\"target\"] == 0).sum()),\n","      \"disease_%\": round(table[\"target\"].mean() * 100, 1),\n","      \"median_age\": table[\"age\"].median(),\n","      \"male_%\": round(table[\"sex\"].mean() * 100,1)\n","  })\n","\n","summary = pd.DataFrame(summary_rows)\n","summary.to_csv(out_folder / \"hospital_summary.csv\", index = False)\n","print(\"\\nHospital Summary:\")\n","print(summary.to_string(index=False))"]},{"cell_type":"code","execution_count":14,"metadata":{"executionInfo":{"elapsed":3,"status":"ok","timestamp":1795710355362,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"wzpBEE-f9ZS2"},"outputs":[],"source":["# Create the \"pipeline\" - it prepares the data and trains the model together.\n","# It fills in missing information using ONLY the training hospitals, and then uses\n","# the same information when testing patients from another hospital. This makes\n","# the test fair.\n","\n","def build_pipeline(model, features):\n","  # Keep only the feature groups that are in this tier's list\n","  numbers = [f for f in number_features if f in features]\n","  yes_no  = [f for f in yes_no_features if f in features]\n","  categories = [f for f in category_features if f in features]\n","\n","  prepare = ColumnTransformer([\n","      # Fill gaps with the middle value (median), then put all the numbers on a\n","      # similar scale.\n","      (\"numbers\", Pipeline([(\"fill\", SimpleImputer(strategy=\"median\")),\n","                            (\"scale\", StandardScaler())]), numbers),\n","\n","      # yes/no features: fill gaps with the most common answer\n","      (\"yes_no\", SimpleImputer(strategy=\"most_frequent\"), yes_no),\n","\n","      # Category features: fill gaps with the most common answer, then turn each\n","      # category into its own 0/1 column, as chest pain types 1, 2, 3, 4 are labels\n","      # and not a scale where 4 > 3 > 2 > 1.\n","      (\"categories\", Pipeline([\n","          (\"fill\", SimpleImputer(strategy=\"most_frequent\")),\n","          (\"one_hot\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)),\n","      ]), categories),\n","  ])\n","  return Pipeline([(\"prepare\", prepare), (\"model\", model)])\n","\n","# The three models we compare:\n","Models = {\n","    \"LogReg\": lambda: LogisticRegression(max_iter=1000, random_state=SEED),\n","    \"RandomForest\": lambda: RandomForestClassifier(\n","        n_estimators=200, min_samples_leaf = 3, random_state=SEED),\n","    \"GradBoost\": lambda: GradientBoostingClassifier(\n","        n_estimators = 100, max_depth = 2, learning_rate = 0.05, random_state = SEED),\n","}"]},{"cell_type":"code","execution_count":15,"metadata":{"executionInfo":{"elapsed":40,"status":"ok","timestamp":1795710355403,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"},"user_tz":360},"id":"RF1vbI30BvUp"},"outputs":[],"source":["# Measure how well the model did.\n","\n","metric_names = [\"AUC\", \"accuracy\", \"balanced_accuracy\", \"sensitivity\",\n","                \"specificity\", \"brier\"]\n","\n","def measure(true, risk):\n","  # true = the TRUE answers (1 = disease, 0 = no disease)\n","  # risk = the model's predicted chance of disease for each patient (0 to 1)\n","  guess = (risk >= CUTOFF).astype(int) # turn risks into a yes/no guess\n","  true_pos = np.sum((guess == 1) & (true == 1)) # the patient is sick and the model also predicted sick\n","  true_neg = np.sum((guess == 0) & (true == 0)) # the patient is healthy and the model also predicted healthy\n","  false_pos = np.sum((guess == 1) & (true == 0)) # the patient is healthy but the model predicted sick\n","  false_neg = np.sum((guess == 0) & (true == 1)) # the patient is sick but the model predicted healthy\n","\n","  # Sensitivity: Out of all the sick patients, how many did we correctly identify as sick?\n","  sensitivity = true_pos / (true_pos + false_neg)\n","  # Specificity: Out of all the healthy patients, how many did we correctly identify as healthy?\n","  specificity = true_neg / (true_neg + false_pos)\n","\n","  return {\n","      \"AUC\": roc_auc_score(true, risk), # ranking quality\n","      \"accuracy\": (true_pos + true_neg) / len(true), # share of correct guesses\n","      \"balanced_accuracy\": (sensitivity + specificity) / 2, # fair when groups are uneven\n","      \"sensitivity\": sensitivity,\n","      \"specificity\": specificity,\n","      \"brier\": brier_score_loss(true, risk), # error of the risk numbers (lower = better)\n","  }\n","\n","def calibration(true, risk):\n","  # Will check if the model's predicted risk matches the actual number of patients\n","  # who have the disease, showing whether the model over- or under- estimates the risk.\n","  # cal_slope of 1.0 is ideal. Below 1.0 means predictions are too extreme.\n","  risk_safe = np.clip(risk, 1e-6, 1 - 1e-6) # avoid log(0)\n","  log_odds = np.log(risk_safe / (1 - risk_safe)).reshape(-1, 1)\n","  fit = LogisticRegression(C=1e6, max_iter=1000).fit(log_odds, true)\n","  return{\n","      \"mean_predicted_risk\": risk.mean(),\n","      \"observed_prevalence\": true.mean(),\n","      \"cal_slope\": float(fit.coef_[0,0]),\n","      \"cal_intercept\": float(fit.intercept_[0]),\n","  }\n","\n","def confidence_intervals(true, risk, random_gen):\n","  # The test is repeated 1000 times using different samples of the test patients\n","  # to calculate a 95% confidence interval. It is done to show how much the AUC\n","  # results might vary, while keeping the trained model the same.\n","  sick = np.where(true == 1)[0]    # positions of sick patients\n","  healthy = np.where(true == 0)[0] # positions of healthy patients\n","  results = {name: [] for name in metric_names}\n","  for _ in range(N_BOOT):\n","    picked = np.concatenate([random_gen.choice(sick, len(sick)),\n","                             random_gen.choice(healthy, len(healthy))])\n","    scores = measure(true[picked], risk[picked])\n","    for name in metric_names:\n","      results[name].append(scores[name])\n","  # 2.5th and 97.5th percentiles = the middle 95%\n","  return {name: (np.nanpercentile(v, 2.5), np.nanpercentile(v, 97.5))\n","    for name, v in results.items()}"]},{"cell_type":"code","execution_count":16,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EOQxQneyJ0EW","executionInfo":{"status":"ok","timestamp":1795710707597,"user_tz":360,"elapsed":352192,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"}},"outputId":"a2580c4a-d79c-4cfe-8c73-8e1296a8c3df"},"outputs":[{"output_type":"stream","name":"stdout","text":["[A1: Cleveland | accessible | LogReg] internal AUC = 0.843\n","[A1: Cleveland | accessible | RandomForest] internal AUC = 0.838\n","[A1: Cleveland | accessible | GradBoost] internal AUC = 0.822\n","[A1: Cleveland | accessible_no_chol | LogReg] internal AUC = 0.842\n","[A1: Cleveland | accessible_no_chol | RandomForest] internal AUC = 0.838\n","[A1: Cleveland | accessible_no_chol | GradBoost] internal AUC = 0.822\n","[A1: Cleveland | +ecg | LogReg] internal AUC = 0.842\n","[A1: Cleveland | +ecg | RandomForest] internal AUC = 0.830\n","[A1: Cleveland | +ecg | GradBoost] internal AUC = 0.822\n","[A1: Cleveland | full | LogReg] internal AUC = 0.884\n","[A1: Cleveland | full | RandomForest] internal AUC = 0.870\n","[A1: Cleveland | full | GradBoost] internal AUC = 0.864\n","[A2: Cleveland+Hungary | accessible | LogReg] internal AUC = 0.845\n","[A2: Cleveland+Hungary | accessible | RandomForest] internal AUC = 0.834\n","[A2: Cleveland+Hungary | accessible | GradBoost] internal AUC = 0.837\n","[A2: Cleveland+Hungary | accessible_no_chol | LogReg] internal AUC = 0.842\n","[A2: Cleveland+Hungary | accessible_no_chol | RandomForest] internal AUC = 0.839\n","[A2: Cleveland+Hungary | accessible_no_chol | GradBoost] internal AUC = 0.838\n","[A2: Cleveland+Hungary | +ecg | LogReg] internal AUC = 0.842\n","[A2: Cleveland+Hungary | +ecg | RandomForest] internal AUC = 0.838\n","[A2: Cleveland+Hungary | +ecg | GradBoost] internal AUC = 0.837\n","[A2: Cleveland+Hungary | full | LogReg] internal AUC = 0.888\n","[A2: Cleveland+Hungary | full | RandomForest] internal AUC = 0.883\n","[A2: Cleveland+Hungary | full | GradBoost] internal AUC = 0.875\n"]}],"source":["# MAIN LOOP: For each setup, tier, and model:\n","#   a) train on the training hospitals\n","#   b) check it on the same data with cross-validation (internal scoring)\n","#   c) test it on each unseen hospital\n","#   d) measure which features matter for the model\n","\n","random_gen = np.random.default_rng(SEED)\n","cross_validation = RepeatedStratifiedKFold(n_splits=5, n_repeats=3, random_state=SEED)\n","\n","performance_rows = []\n","importance_rows = []\n","\n","for setup_name, (train_hospitals, test_hospitals) in setups.items():\n","  # For A2, stack the training hospitals (Cleveland + Hungary) into one table\n","  train_table = pd.concat([hospitals[h] for h in train_hospitals], ignore_index=True)\n","  y_train = train_table[\"target\"].to_numpy()\n","\n","  for tier_name, features in TIERS.items():\n","    X_train = train_table[features]\n","\n","    for model_name, make_model in Models.items():\n","      # a) TRAIN\n","      pipeline = build_pipeline(make_model(), features)\n","      pipeline.fit(X_train, y_train)\n","\n","      # b) INTERNAL SCORE: Split the training patients into 5 groups. Train on 4, test\n","      # on the 5th, and repeat. This tells how the model does on patients from the\n","      # SAME hospital(s). Comparing it with the score on a NEW hospital\n","      # shows how much performance is lost when we move.\n","      internal_auc = cross_val_score(\n","          build_pipeline(make_model(), features), X_train, y_train,\n","          scoring = \"roc_auc\", cv = cross_validation).mean()\n","      print(f\"[{setup_name} | {tier_name} | {model_name}] \"\n","            f\"internal AUC = {internal_auc:.3f}\")\n","\n","      # d-1) Determine feature importance on the TRAINING PATIENTS, for reference.\n","      # Use \"permutation importance\" - it shuffles one feature's value so it becomes\n","      # meaningless, and then we look at how much the AUC drops. The bigger the drop,\n","      # the more the model relies on that feature.\n","      result = permutation_importance(pipeline, X_train, y_train,\n","                                      scoring = \"roc_auc\", n_repeats = N_PERM,\n","                                      random_state = SEED)\n","      for feature, mean_drop in zip(features, result.importances_mean):\n","        importance_rows.append({\n","            \"setup\": setup_name, \"tier\": tier_name, \"model\": model_name,\n","            \"test_hospital\": \"TRAINING DATA\", \"feature\": feature,\n","            \"importance\": mean_drop\n","            })\n","\n","      # c) TEST on every hospital the model has never seen:\n","      for test_hospital in test_hospitals:\n","        X_test = hospitals[test_hospital][features]\n","        y_test = hospitals[test_hospital][\"target\"].to_numpy()\n","\n","        # Ask the model for each test patient's chance of disease:\n","        risk = pipeline.predict_proba(X_test)[:, 1]\n","\n","        scores = measure(y_test, risk)\n","        intervals = confidence_intervals(y_test, risk, random_gen)\n","\n","        row = {\n","            \"setup\": setup_name, \"tier\": tier_name, \"model\": model_name,\n","            \"test_hospital\": test_hospital,\n","            \"n_test\": len(y_test),\n","            \"n_without_disease\": int((y_test == 0).sum()),\n","            # how much of this tier's data was missing (these gaps were filled in):\n","            \"pct_missing_in_features\": round(X_test.isna().mean().mean() * 100, 1),\n","            \"internal_AUC\": internal_auc,\n","            \"AUC_drop_vs_internal\": internal_auc - scores[\"AUC\"]\n","          }\n","        for name in metric_names:\n","          row[name] = scores[name]\n","          row[name + \"_low\"], row[name + \"_high\"] = intervals[name]\n","        row.update(calibration(y_test, risk))\n","        performance_rows.append(row)\n","\n","        # d-2) Determine feature importance on the TESTING PATIENTS. If it differs\n","        # here, the model is relying on different things at different hospitals.\n","        result = permutation_importance(pipeline, X_test, y_test,\n","                                        scoring = \"roc_auc\", n_repeats = N_PERM,\n","                                        random_state = SEED)\n","        for feature, mean_drop in zip(features, result.importances_mean):\n","          importance_rows.append({\n","              \"setup\": setup_name, \"tier\": tier_name, \"model\": model_name,\n","              \"test_hospital\": test_hospital, \"feature\": feature,\n","              \"importance\": mean_drop\n","          })"]},{"cell_type":"code","execution_count":17,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SyEUo1mHLSMS","executionInfo":{"status":"ok","timestamp":1795710708424,"user_tz":360,"elapsed":826,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"}},"outputId":"0e47ef01-fa33-4e6c-c4b4-1364f1b3b058"},"outputs":[{"output_type":"stream","name":"stdout","text":["\n","AUC on unseen hospitals (95% confidence interval in brackets):\n","setup                               A1: Cleveland                                     A2: Cleveland+Hungary                  \n","test_h