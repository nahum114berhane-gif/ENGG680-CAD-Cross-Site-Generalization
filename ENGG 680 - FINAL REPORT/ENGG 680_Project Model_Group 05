 WITHOUT disease, so its confidence \"\n","      \"intervals are wide. Treat those results as tentative.\")"]},{"cell_type":"code","source":["# IMPORTANT FIGURES - COMPARISON\n","\n","import matplotlib.pyplot as plt\n","\n","# Use the main feature group and first training setup\n","p = performance.query(\"tier == 'accessible' and setup == 'A1: Cleveland'\")\n","hospitals_list = [\"Hungary\", \"Switzerland\", \"LongBeach\"]\n","models = [\"LogReg\", \"RandomForest\", \"GradBoost\"]\n","\n","# FIGURE 1: PATIENT DISTRIBUTION BY HOSPITAL\n","summary.set_index(\"hospital\")[[\"with_disease\", \"without_disease\"]].plot(\n","    kind=\"bar\", stacked = True, figsize = (8,4),\n","    title = \"Distribution of CAD Patients Across Hospitals\"\n",")\n","\n","plt.ylabel(\"Number of Patients\")\n","plt.xlabel(\"Hospital\")\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# FIGURE 2: AUC COMPARISON WITH 95% CONFIDENCE INTERVALS (CI)\n","fig, axes = plt.subplots(1, 3, figsize = (14,4), sharey = True)\n","for ax, h in zip(axes, hospitals_list):\n","  d = p[p.test_hospital == h].set_index(\"model\").reindex(models)\n","\n","  ax.errorbar(models, d.AUC,\n","        yerr=[d.AUC - d.AUC_low, d.AUC_high - d.AUC],\n","        fmt = \"o\", capsize = 4,)\n","  ax.set(title = h, ylim = (0,1), ylabel = \"AUC\")\n","  ax.tick_params(axis=\"x\", rotation = 30)\n","\n","plt.suptitle(\"AUC Comparison Across Hospitals (95% CI)\")\n","plt.tight_layout()\n","plt.show()\n","\n","# FIGURE 3: SENSITIVITY AND SPECIFICITY\n","p.set_index([\"test_hospital\", \"model\"])[\n","  [\"sensitivity\", \"specificity\"]\n","].unstack(\"model\").plot(kind = \"bar\", figsize = (11,5))\n","\n","plt.title(\"Sensitivity and Specificity Across Hospitals\")\n","plt.ylabel(\"Score\")\n","plt.ylim(0,1)\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# FIGURE 4: PREDICTED VS. ACTUAL DISEASE RATE\n","for model, d in p.groupby(\"model\"):\n","  plt.scatter(d.observed_prevalence, d.mean_predicted_risk, label = model, s = 65)\n","\n","plt.plot([0,1],[0,1],\"--\",label = \"Perfect Agreement\")\n","plt.xlabel(\"Actual Disease Prevalence\")\n","plt.ylabel(\"Mean Predicted Risk\")\n","plt.title(\"Predicted Risk vs Actual Disease Prevalence\")\n","plt.legend()\n","plt.tight_layout()\n","plt.show()\n","\n","# FIGURE 5: FEATURE IMPORTANCE (HUNGARY TEST GROUP)\n","d = importance.query(\n","    \"setup == 'A1: Cleveland' and tier == 'accessible' \"\n","    \"and test_hospital == 'Hungary'\"\n",")\n","d.pivot(index = \"feature\", columns = \"model\",\n","        values = \"importance\").plot(kind = \"barh\", figsize = (9,6))\n","plt.title(\"Feature Importance Across Models (Hungary)\")\n","plt.xlabel(\"Decrease in AUC\")\n","plt.tight_layout()\n","plt.show()\n","\n","# FIGURE 6: AUC ACROSS FEATURE TIERS (FEATURE-TIER COMPARISON)\n","tiers = [\"accessible\", \"accessible_no_chol\", \"+ecg\", \"full\"]\n","\n","# Use all feature tiers from the first training setup\n","tier_data = performance.query(\"setup == 'A1: Cleveland'\")\n","fig, axes = plt.subplots(1, 3, figsize = (15, 5), sharey = True)\n","\n","for ax, h in zip(axes, hospitals_list):\n","  for model in models:\n","    d = tier_data[\n","        (tier_data.test_hospital == h) &\n","        (tier_data.model == model)\n","    ].set_index(\"tier\").reindex(tiers)\n","\n","    ax.plot(tiers, d[\"AUC\"], marker = \"o\", label = model)\n","\n","  ax.set_title(h)\n","  ax.set_xlabel(\"Feature Tier\")\n","  ax.set_ylim(0,1)\n","  ax.tick_params(axis = \"x\", rotation = 30)\n","  ax.grid(alpha = 0.3)\n","\n","axes[0].set_ylabel(\"AUC\")\n","axes[0].legend()\n","\n","plt.suptitle(\"AUC Across Feature Tiers by Test Hospital\")\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"yjdN1-7ZLR2y","executionInfo":{"status":"ok","timestamp":1795710711078,"user_tz":360,"elapsed":2650,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"}},"outputId":"5ad3fcc5-6727-