ificity\", \"Precision\", \"Accuracy\"]].round(2)\n","\n","print(table)\n","table.to_csv(out_folder / \"metrics_table_A1.csv\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0lukRCwjjn1V","executionInfo":{"status":"ok","timestamp":1795710966368,"user_tz":360,"elapsed":121,"user":{"displayName":"Qurat Ul Ain Khalid","userId":"08788515603628579331"}},"outputId":"b620c921-fd30-4f8d-ff85-5a2899c4b7a4"},"execution_count":24,"outputs":[{"output_type":"stream","name":"stdout","text":["               n_test  Disease Rate  Sensitivity (Recall)  Specificity  \\\n","test_hospital                                                            \n","Hungary           294          0.36                  0.75         0.84   \n","Switzerland       123          0.93                  0.82         0.62   \n","LongBeach         200          0.74                  0.76         0.53   \n","\n","               Precision  Accuracy  \n","test_hospital                       \n","Hungary             0.72       0.8  \n","Switzerland         0.97       0.8  \n","LongBeach           0.82       0.7  \n"]}]}],"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPAkD9sLxEVesj0VIK/1nMq"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}